# Workspace root for the NautilusTrader Bazel module.
#
# Exposes the Cargo.toml / Cargo.lock pair so that crate_universe
# (declared in MODULE.bazel) can reference them as //:Cargo.toml and
# //:Cargo.lock. Nothing Python-related is exported — Bazel builds
# the Rust crates directly via rules_rust, without cargo or maturin.

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])
