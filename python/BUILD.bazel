# NautilusTrader v2 Python wrapper — evaluation only.
#
# This BUILD file wraps NautilusTrader's v2 Python package (built via
# maturin from the pyo3 bridge) so that Python consumers inside the
# parent monorepo can import `nautilus_trader`. The native Rust
# extensions are built by NautilusTrader's upstream Makefile
# (`make build-debug-v2`), which runs:
#
#     cd python && uv run maturin develop
#
# Replicating maturin's pyo3 + cdylib build in Bazel would require
# wiring every transitive crate through rules_rust, so we shell out
# instead. The Rust library targets under //crates/... are fully
# independent of this Python target — consumers pick one or both.
#
# Two public targets:
#
#   :build_native_v2
#       genrule that runs `make build-debug-v2` inside the submodule.
#       Bazel tracks the Rust crate / pyo3 glue source globs as inputs
#       so the native build re-runs when they change. The resulting
#       `_libnautilus.so` and supporting artifacts land in
#       python/nautilus_trader/**; the genrule's own output is a
#       timestamp stamp file.
#
#   :nautilus_trader
#       py_library globbing the Python sources plus the .so/.pyi files
#       produced by :build_native_v2. Depends on :build_native_v2 so
#       consumers get incremental rebuilds when Rust sources change.
#
# ─── FRESH-CLONE BOOTSTRAP (one time, per workspace) ──────────────────────
#
# Bazel evaluates globs during the loading phase, BEFORE any action
# runs. On a fresh clone the `_libnautilus.so` glob in :nautilus_trader
# returns empty, so a single `bazel build` will run :build_native_v2
# but the resulting artifacts won't be picked up by the py_library in
# the same invocation. To bootstrap:
#
#     bazel run //third_party/nautilus_trader/python:build_native_v2
#     bazel build //third_party/nautilus_trader/python:nautilus_trader
#
# After that, incremental rebuilds are triggered by changes to the
# declared source globs.
#
# ─── REQUIREMENTS ─────────────────────────────────────────────────────────
#
# Host must have Rust (see ../rust-toolchain.toml), uv (see
# ../pyproject.toml), clang, and make. The genrule runs with
# `local = True` and no sandbox because maturin writes into the
# python/.venv tree and cargo needs network access.

load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "build_native_v2",
    # NOTE: Bazel globs cannot cross package boundaries, so we cannot
    # glob Rust sources from ../crates/... (each crate is now its own
    # Bazel package). We track the lockfile + python-side files; that
    # forces a rebuild when dependency versions change. For pure Rust
    # source edits without a lockfile bump, users must rerun this
    # target explicitly — acceptable for evaluation use.
    srcs = glob(
        [
            "pyproject.toml",
            "uv.lock",
            "nautilus_trader/**/*.py",
            "nautilus_trader/**/*.pyi",
        ],
        allow_empty = True,
    ) + [
        "//:Cargo.toml",
        "//:Cargo.lock",
        "//:pyproject.toml",
        "//:Makefile",
        "//:rust-toolchain.toml",
    ],
    outs = ["build_native_v2.stamp"],
    # Bazel strips PATH for actions even with local=True. Restore a
    # sensible PATH covering Homebrew (macOS), cargo (~/.cargo/bin),
    # uv (~/.local/bin), and standard system bins so make, uv, cargo,
    # rustc, and clang are all reachable.
    cmd = "export PATH=/opt/homebrew/bin:/opt/homebrew/sbin:$$HOME/.cargo/bin:$$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$$PATH && (cd $$(dirname $(location //:Makefile)) && make build-debug-v2) 1>&2 && date -u +%Y-%m-%dT%H:%M:%SZ > $@",
    executable = True,
    local = True,
    message = "Building NautilusTrader v2 native extension (maturin develop)",
    tags = [
        "no-cache",
        "no-remote",
        "no-sandbox",
        "requires-network",
    ],
)

py_library(
    name = "nautilus_trader",
    srcs = glob(
        ["nautilus_trader/**/*.py"],
        exclude = ["nautilus_trader/**/__pycache__/**"],
    ),
    data = glob(
        [
            "nautilus_trader/**/*.so",
            "nautilus_trader/**/*.pyi",
            "nautilus_trader/py.typed",
        ],
        allow_empty = True,
    ) + [":build_native_v2"],
    imports = ["."],
)
