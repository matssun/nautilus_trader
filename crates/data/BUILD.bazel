# nautilus-data — data engine, aggregation, caches for market data.

load("@nt_bazel_defs//rust:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

nt_rust_test(
    name = "nautilus_data_test",
    crate = ":nautilus_data",
    crate_features = ["defi"],
    edition = "2024",
    deps = [
        # alloy_primitives is used inside #[cfg(test)] in src/defi/engine.rs.
        "@nt_crates//:alloy-primitives",
        "@nt_crates//:rstest",
    ],
)

nt_rust_library(
    name = "nautilus_data",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["defi"],
    crate_name = "nautilus_data",
    edition = "2024",
    proc_macro_deps = [
        "@nt_crates//:async-trait",
    ],
    deps = [
        "//crates/common:nautilus_common",
        "//crates/core:nautilus_core",
        "//crates/model:nautilus_model",
        "@nt_crates//:ahash",
        "@nt_crates//:anyhow",
        "@nt_crates//:bon",
        "@nt_crates//:chrono",
        "@nt_crates//:futures",
        "@nt_crates//:indexmap",
        "@nt_crates//:log",
        "@nt_crates//:ustr",
    ],
)
