# nautilus-serialization — SBE / Arrow serialization for the domain model.
#
# Features intentionally enabled: sbe, arrow, high-precision.
# Cap'n Proto (`capnp`) is NOT enabled — it would require compiling
# .capnp schemas via capnpc during the build script, which needs extra
# Bazel wiring. The sbe + arrow path is enough for the binance / bitmex
# adapter surface we're validating in this phase.
#
# The build script is a no-op in non-capnp mode (just emits a check-cfg
# directive) so we can skip cargo_build_script entirely.

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "nautilus_serialization",
    srcs = glob(["src/**/*.rs"]),
    crate_features = [
        "arrow",
        "high-precision",
        "sbe",
    ],
    crate_name = "nautilus_serialization",
    edition = "2024",
    proc_macro_deps = [
        "@nt_crates//:rust_decimal_macros",
    ],
    deps = [
        "//crates/core:nautilus_core",
        "//crates/model:nautilus_model",
        "@nt_crates//:anyhow",
        "@nt_crates//:arrow",
        "@nt_crates//:indexmap",
        "@nt_crates//:rust_decimal",
        "@nt_crates//:serde",
        "@nt_crates//:serde_json",
        "@nt_crates//:thiserror",
        "@nt_crates//:ustr",
        "@nt_crates//:uuid",
    ],
)
