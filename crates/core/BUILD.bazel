# nautilus-core — fundamental building blocks (UUID, time, message types,
# correctness primitives) used by every other nautilus crate.
#
# Built with the `ffi` feature (for the src/ffi/ Rust helper module:
# CVec, abort_on_panic, string/datetime/uuid FFI helpers). Not built
# with `python` or `extension-module`.

load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@nt_bazel_defs//rust:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    build_script_env = {
        "CARGO_PKG_VERSION": "0.56.0",
    },
    edition = "2024",
    deps = [
        "@nt_crates//:toml",
    ],
)

nt_rust_test(
    name = "nautilus_core_test",
    crate = ":nautilus_core",
    crate_features = ["ffi"],
    edition = "2024",
    proc_macro_deps = [
        "@nt_crates//:rust_decimal_macros",
    ],
    deps = [
        "@nt_crates//:dashmap",
        "@nt_crates//:proptest",
        "@nt_crates//:rstest",
    ],
)

nt_rust_library(
    name = "nautilus_core",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["ffi"],
    crate_name = "nautilus_core",
    edition = "2024",
    deps = [
        ":build_script",
        "@nt_crates//:ahash",
        "@nt_crates//:anyhow",
        "@nt_crates//:arc-swap",
        "@nt_crates//:bytes",
        "@nt_crates//:chrono",
        "@nt_crates//:indexmap",
        "@nt_crates//:log",
        "@nt_crates//:rand",
        "@nt_crates//:rmp-serde",
        "@nt_crates//:rust_decimal",
        "@nt_crates//:serde",
        "@nt_crates//:serde_json",
        "@nt_crates//:ustr",
        "@nt_crates//:uuid",
    ],
)
