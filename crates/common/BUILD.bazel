# nautilus-common — shared machinery: cache, message bus, clocks, runner,
# runtime, timers.

load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@nt_bazel_defs//rust:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    build_script_env = {
        "CARGO_PKG_VERSION": "0.56.0",
    },
    data = [
        "cbindgen.toml",
        "cbindgen_cython.toml",
    ],
    edition = "2024",
    deps = [],
)

# Logger tests that mutate process-global state. nt_rust_test generates
# one isolated rust_test target per _SERIAL_TESTS entry so Bazel
# schedules each as its own process.
_SERIAL_TESTS = [
    "logging::logger::tests::serial_tests::test_logging_to_file",
    "logging::logger::tests::serial_tests::test_logging_to_file_in_json_format",
    "logging::logger::tests::serial_tests::test_init_sets_logging_is_initialized_flag",
    "logging::logger::tests::serial_tests::test_reinit_after_guard_drop_fails",
    "logging::logger::tests::serial_tests::test_module_level_filtering",
    "logging::logger::tests::serial_tests::test_log_component_level_filtering",
    "logging::logger::tests::serial_tests::test_bypass_before_init_prevents_logging",
    "logging::logger::tests::serial_tests::test_shutdown_drains_backlog_tail",
    "logging::macros::tests::test_colored_logging_macros",
    "logging::macros::tests::test_default_macro_captures_module_path",
]

nt_rust_test(
    name = "nautilus_common_test",
    crate = ":nautilus_common",
    crate_features = [
        "defi",
        "indicators",
        "live",
        "rstest",
    ],
    edition = "2024",
    proc_macro_deps = [
        "@nt_crates//:rust_decimal_macros",
    ],
    serial_tests = _SERIAL_TESTS,
    # Timing-sensitive test; the invariant it checks is never used in
    # production code. Should be removed upstream.
    skip_tests = [
        "live::clock::tests::test_live_timer_short_delay_not_early",
    ],
    deps = [
        "@nt_crates//:alloy-primitives",
        "@nt_crates//:proptest",
        "@nt_crates//:rand",
        "@nt_crates//:tempfile",
    ],
)

nt_rust_library(
    name = "nautilus_common",
    srcs = glob(["src/**/*.rs"]),
    crate_features = [
        "defi",
        "indicators",
        "live",
        "rstest",
    ],
    crate_name = "nautilus_common",
    edition = "2024",
    proc_macro_deps = [
        "@nt_crates//:async-trait",
    ],
    deps = [
        ":build_script",
        "//crates/core:nautilus_core",
        "//crates/indicators:nautilus_indicators",
        "//crates/model:nautilus_model",
        "@nt_crates//:ahash",
        "@nt_crates//:anyhow",
        "@nt_crates//:arraydeque",
        "@nt_crates//:async-stream",
        "@nt_crates//:bon",
        "@nt_crates//:bytes",
        "@nt_crates//:chrono",
        "@nt_crates//:derive_builder",
        "@nt_crates//:futures",
        "@nt_crates//:indexmap",
        "@nt_crates//:log",
        "@nt_crates//:regex",
        "@nt_crates//:rstest",
        "@nt_crates//:rust_decimal",
        "@nt_crates//:serde",
        "@nt_crates//:serde_json",
        "@nt_crates//:smallvec",
        "@nt_crates//:strum",
        "@nt_crates//:sysinfo",
        "@nt_crates//:tokio",
        "@nt_crates//:ustr",
    ],
)
