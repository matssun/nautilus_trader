# nautilus-kraken — Kraken Pro adapter.

load("@nt_bazel_defs//rust:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

nt_rust_test(
    name = "nautilus_kraken_test",
    crate = ":nautilus_kraken",
    # include_str!("../../../test_data/...") in src/websocket/futures/
    # needs JSON fixtures visible at compile time.
    compile_data = glob(["test_data/**"]),
    crate_features = ["high-precision"],
    # load_test_data() in src/http/spot/models.rs, src/http/futures/models.rs
    # and src/websocket/spot_v2/messages.rs resolves fixtures at runtime
    # via runfiles; pass the full test_data/ set plus a sentinel.
    data = glob(["test_data/**"]),
    edition = "2024",
    fixture_files = {
        "KRAKEN_TEST_DATA": "test_data/http_asset_pairs.json",
    },
    deps = [
        "//crates/testkit:nautilus_testkit",
        "@nt_crates//:axum",
        "@nt_crates//:dotenvy",
        "@nt_crates//:rstest",
        "@nt_crates//:url",
    ],
)

nt_rust_library(
    name = "nautilus_kraken",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["high-precision"],
    crate_name = "nautilus_kraken",
    edition = "2024",
    proc_macro_deps = [
        "@nt_crates//:async-trait",
        "@nt_crates//:rust_decimal_macros",
    ],
    deps = [
        "//crates/common:nautilus_common",
        "//crates/core:nautilus_core",
        "//crates/live:nautilus_live",
        "//crates/model:nautilus_model",
        "//crates/network:nautilus_network",
        "//crates/system:nautilus_system",
        "//crates/trading:nautilus_trading",
        "@nt_crates//:ahash",
        "@nt_crates//:anyhow",
        "@nt_crates//:arc-swap",
        "@nt_crates//:async-stream",
        "@nt_crates//:aws-lc-rs",
        "@nt_crates//:base64",
        "@nt_crates//:bon",
        "@nt_crates//:chrono",
        "@nt_crates//:dashmap",
        "@nt_crates//:derive_builder",
        "@nt_crates//:futures-util",
        "@nt_crates//:indexmap",
        "@nt_crates//:log",
        "@nt_crates//:rust_decimal",
        "@nt_crates//:serde",
        "@nt_crates//:serde_json",
        "@nt_crates//:serde_urlencoded",
        "@nt_crates//:strum",
        "@nt_crates//:thiserror",
        "@nt_crates//:tokio",
        "@nt_crates//:tokio-tungstenite",
        "@nt_crates//:tokio-util",
        "@nt_crates//:ustr",
        "@nt_crates//:zeroize",
    ],
)
