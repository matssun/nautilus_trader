# nautilus-sandbox — paper-trading execution adapter.

load("@nt_bazel_defs//rust:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

nt_rust_test(
    name = "nautilus_sandbox_test",
    crate = ":nautilus_sandbox",
    crate_features = ["high-precision"],
    edition = "2024",
    deps = [
        "//crates/testkit:nautilus_testkit",
        "@nt_crates//:rstest",
        "@nt_crates//:tokio",
    ],
)

nt_rust_library(
    name = "nautilus_sandbox",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["high-precision"],
    crate_name = "nautilus_sandbox",
    edition = "2024",
    proc_macro_deps = [
        "@nt_crates//:async-trait",
    ],
    deps = [
        "//crates/common:nautilus_common",
        "//crates/core:nautilus_core",
        "//crates/execution:nautilus_execution",
        "//crates/model:nautilus_model",
        "//crates/system:nautilus_system",
        "//crates/trading:nautilus_trading",
        "@nt_crates//:ahash",
        "@nt_crates//:anyhow",
        "@nt_crates//:bon",
        "@nt_crates//:derive_builder",
        "@nt_crates//:log",
        "@nt_crates//:rust_decimal",
        "@nt_crates//:serde",
        "@nt_crates//:thiserror",
        "@nt_crates//:ustr",
    ],
)
