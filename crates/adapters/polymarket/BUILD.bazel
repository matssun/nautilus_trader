# nautilus-polymarket — Polymarket prediction-market adapter. Alloy
# provider is used for EVM RPC.

load("@nt_bazel_defs//rust:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

nt_rust_test(
    name = "nautilus_polymarket_test",
    crate = ":nautilus_polymarket",
    crate_features = ["high-precision"],
    # src/common/testing.rs::test_data_path() resolves fixtures via runfiles.
    # Upstream uses the helper from many src/ test modules that previously
    # relied on a cwd-relative `test_data/` path.
    data = glob(["test_data/**"]),
    edition = "2024",
    fixture_files = {
        "POLYMARKET_TEST_DATA": "test_data/clob_book_response.json",
    },
    deps = [
        "//crates/testkit:nautilus_testkit",
        "//crates/trading:nautilus_trading",
        "@nt_crates//:axum",
        "@nt_crates//:rstest",
    ],
)

nt_rust_library(
    name = "nautilus_polymarket",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["high-precision"],
    crate_name = "nautilus_polymarket",
    edition = "2024",
    proc_macro_deps = [
        "@nt_crates//:async-trait",
        "@nt_crates//:rust_decimal_macros",
        "@nt_crates//:serde_repr",
    ],
    deps = [
        "//crates/common:nautilus_common",
        "//crates/core:nautilus_core",
        "//crates/live:nautilus_live",
        "//crates/model:nautilus_model",
        "//crates/network:nautilus_network",
        "//crates/system:nautilus_system",
        "//crates/trading:nautilus_trading",
        "@nt_crates//:ahash",
        "@nt_crates//:alloy",
        "@nt_crates//:alloy-primitives",
        "@nt_crates//:anyhow",
        "@nt_crates//:arc-swap",
        "@nt_crates//:aws-lc-rs",
        "@nt_crates//:base64",
        "@nt_crates//:bon",
        "@nt_crates//:chrono",
        "@nt_crates//:dashmap",
        "@nt_crates//:derive_builder",
        "@nt_crates//:dotenvy",
        "@nt_crates//:futures-util",
        "@nt_crates//:log",
        "@nt_crates//:rust_decimal",
        "@nt_crates//:serde",
        "@nt_crates//:serde_json",
        "@nt_crates//:strum",
        "@nt_crates//:thiserror",
        "@nt_crates//:tokio",
        "@nt_crates//:tokio-tungstenite",
        "@nt_crates//:tokio-util",
        "@nt_crates//:url",
        "@nt_crates//:ustr",
        "@nt_crates//:uuid",
        "@nt_crates//:zeroize",
    ],
)
