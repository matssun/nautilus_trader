# nautilus-hyperliquid — Hyperliquid perp DEX adapter. Uses alloy for
# EVM signing.

load("@nt_bazel_defs//rust:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

nt_rust_test(
    name = "nautilus_hyperliquid_test",
    crate = ":nautilus_hyperliquid",
    crate_features = ["high-precision"],
    # src/common/testing.rs::load_test_data uses runfiles.
    data = glob(["test_data/**"]),
    edition = "2024",
    fixture_files = {
        "HYPERLIQUID_TEST_DATA": "test_data/http_l2_book_btc.json",
    },
    deps = [
        "//crates/testkit:nautilus_testkit",
        "@nt_crates//:axum",
        "@nt_crates//:dotenvy",
        "@nt_crates//:futures-util",
        "@nt_crates//:rstest",
    ],
)

nt_rust_library(
    name = "nautilus_hyperliquid",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["high-precision"],
    crate_name = "nautilus_hyperliquid",
    edition = "2024",
    proc_macro_deps = [
        "@nt_crates//:async-trait",
        "@nt_crates//:rust_decimal_macros",
    ],
    deps = [
        "//crates/common:nautilus_common",
        "//crates/core:nautilus_core",
        "//crates/live:nautilus_live",
        "//crates/model:nautilus_model",
        "//crates/network:nautilus_network",
        "//crates/system:nautilus_system",
        "//crates/trading:nautilus_trading",
        "@nt_crates//:ahash",
        "@nt_crates//:alloy",
        "@nt_crates//:alloy-primitives",
        "@nt_crates//:anyhow",
        "@nt_crates//:arc-swap",
        "@nt_crates//:bon",
        "@nt_crates//:chrono",
        "@nt_crates//:dashmap",
        "@nt_crates//:derive_builder",
        "@nt_crates//:futures-util",
        "@nt_crates//:log",
        "@nt_crates//:rmp-serde",
        "@nt_crates//:rust_decimal",
        "@nt_crates//:serde",
        "@nt_crates//:serde_json",
        "@nt_crates//:strum",
        "@nt_crates//:tabled",
        "@nt_crates//:thiserror",
        "@nt_crates//:tokio",
        "@nt_crates//:tokio-tungstenite",
        "@nt_crates//:tokio-util",
        "@nt_crates//:url",
        "@nt_crates//:ustr",
        "@nt_crates//:uuid",
        "@nt_crates//:zeroize",
    ],
)
