# nautilus-betfair — Betfair exchange adapter.

load("@nt_bazel_defs//rust:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

nt_rust_test(
    name = "nautilus_betfair_test",
    crate = ":nautilus_betfair",
    crate_features = ["high-precision"],
    # src/common/testing.rs::load_test_json uses runfiles.
    data = glob(["test_data/**"]),
    edition = "2024",
    fixture_files = {
        "BETFAIR_TEST_DATA": "test_data/stream/market_definition_racing.json",
    },
    deps = [
        "//crates/backtest:nautilus_backtest",
        "//crates/execution:nautilus_execution",
        "//crates/testkit:nautilus_testkit",
        "//crates/trading:nautilus_trading",
        "@nt_crates//:axum",
        "@nt_crates//:dotenvy",
        "@nt_crates//:rstest",
        "@nt_crates//:tokio",
    ],
)

nt_rust_library(
    name = "nautilus_betfair",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["high-precision"],
    crate_name = "nautilus_betfair",
    edition = "2024",
    proc_macro_deps = [
        "//crates/persistence/macros:nautilus_persistence_macros",
        "@nt_crates//:async-trait",
    ],
    deps = [
        "//crates/common:nautilus_common",
        "//crates/core:nautilus_core",
        "//crates/live:nautilus_live",
        "//crates/model:nautilus_model",
        "//crates/network:nautilus_network",
        "//crates/serialization:nautilus_serialization",
        "//crates/system:nautilus_system",
        "@nt_crates//:ahash",
        "@nt_crates//:anyhow",
        "@nt_crates//:arrow",
        "@nt_crates//:bon",
        "@nt_crates//:bytes",
        "@nt_crates//:bzip2",
        "@nt_crates//:chrono",
        "@nt_crates//:flate2",
        "@nt_crates//:log",
        "@nt_crates//:rust_decimal",
        "@nt_crates//:serde",
        "@nt_crates//:serde_json",
        "@nt_crates//:strum",
        "@nt_crates//:thiserror",
        "@nt_crates//:tokio",
        "@nt_crates//:tokio-tungstenite",
        "@nt_crates//:tokio-util",
        "@nt_crates//:urlencoding",
        "@nt_crates//:ustr",
        "@nt_crates//:zeroize",
    ],
)
