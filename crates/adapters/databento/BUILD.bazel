# nautilus-databento — Databento market data adapter.
# Default features: `live` + `high-precision`.

load("@nt_bazel_defs//rust:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

# One sentinel per directory we need; tests resolve the other files by
# calling .parent() on the sentinel path via the runfiles crate.
# See src/decode.rs / src/loader.rs / src/factories.rs for the helpers.
_DBN_FIXTURES = glob(["test_data/**"])

nt_rust_test(
    name = "nautilus_databento_test",
    crate = ":nautilus_databento",
    crate_features = [
        "high-precision",
        "live",
    ],
    data = _DBN_FIXTURES + ["publishers.json"],
    edition = "2024",
    fixture_files = {
        # Sentinel used by tests to derive the test_data directory via
        # parent(). Runfiles-resolved via the @rules_rust//rust/runfiles
        # crate at test runtime.
        "DBN_SENTINEL": "test_data/test_data.bbo-1m.dbn.zst",
        "DBN_PUBLISHERS": "publishers.json",
    },
    deps = [
        "//crates/testkit:nautilus_testkit",
        "@nt_crates//:proptest",
        "@nt_crates//:rstest",
        "@nt_crates//:tokio",
    ],
)

nt_rust_library(
    name = "nautilus_databento",
    srcs = glob(["src/**/*.rs"]),
    crate_features = [
        "high-precision",
        "live",
    ],
    crate_name = "nautilus_databento",
    edition = "2024",
    proc_macro_deps = [
        "@nt_crates//:async-trait",
    ],
    deps = [
        "//crates/common:nautilus_common",
        "//crates/core:nautilus_core",
        "//crates/live:nautilus_live",
        "//crates/model:nautilus_model",
        "//crates/network:nautilus_network",
        "//crates/system:nautilus_system",
        "@nt_crates//:ahash",
        "@nt_crates//:anyhow",
        "@nt_crates//:databento",
        "@nt_crates//:dotenvy",
        "@nt_crates//:fallible-streaming-iterator",
        "@nt_crates//:indexmap",
        "@nt_crates//:itoa",
        "@nt_crates//:log",
        "@nt_crates//:serde",
        "@nt_crates//:serde_json",
        "@nt_crates//:strum",
        "@nt_crates//:time",
        "@nt_crates//:tokio",
        "@nt_crates//:tokio-util",
        "@nt_crates//:ustr",
        "@nt_crates//:zeroize",
    ],
)
