# nautilus-bitmex — BitMEX exchange adapter.

load("@nt_bazel_defs//rust:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

nt_rust_test(
    name = "nautilus_bitmex_test",
    crate = ":nautilus_bitmex",
    crate_features = ["high-precision"],
    # src/common/testing.rs::load_test_json uses runfiles to resolve fixtures.
    data = glob(["test_data/**"]),
    edition = "2024",
    fixture_files = {
        "BITMEX_TEST_DATA": "test_data/ws_trade_bin_1m.json",
    },
    deps = [
        "//crates/testkit:nautilus_testkit",
        "//crates/trading:nautilus_trading",
        "@nt_crates//:axum",
        "@nt_crates//:dotenvy",
        "@nt_crates//:rstest",
        "@nt_crates//:url",
    ],
)

nt_rust_library(
    name = "nautilus_bitmex",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["high-precision"],
    crate_name = "nautilus_bitmex",
    edition = "2024",
    proc_macro_deps = [
        "@nt_crates//:async-trait",
    ],
    deps = [
        "//crates/common:nautilus_common",
        "//crates/core:nautilus_core",
        "//crates/live:nautilus_live",
        "//crates/model:nautilus_model",
        "//crates/network:nautilus_network",
        "//crates/system:nautilus_system",
        "@nt_crates//:ahash",
        "@nt_crates//:anyhow",
        "@nt_crates//:arc-swap",
        "@nt_crates//:async-stream",
        "@nt_crates//:aws-lc-rs",
        "@nt_crates//:bon",
        "@nt_crates//:chrono",
        "@nt_crates//:dashmap",
        "@nt_crates//:derive_builder",
        "@nt_crates//:futures-util",
        "@nt_crates//:indexmap",
        "@nt_crates//:log",
        "@nt_crates//:rust_decimal",
        "@nt_crates//:serde",
        "@nt_crates//:serde_json",
        "@nt_crates//:serde_urlencoded",
        "@nt_crates//:strum",
        "@nt_crates//:thiserror",
        "@nt_crates//:tokio",
        "@nt_crates//:tokio-tungstenite",
        "@nt_crates//:tokio-util",
        "@nt_crates//:ustr",
        "@nt_crates//:uuid",
        "@nt_crates//:zeroize",
    ],
)
