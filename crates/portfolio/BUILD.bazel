# nautilus-portfolio — portfolio accounting and position tracking.

load("@nt_bazel_defs//rust:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

nt_rust_test(
    name = "nautilus_portfolio_test",
    crate = ":nautilus_portfolio",
    edition = "2024",
    proc_macro_deps = ["@nt_crates//:rust_decimal_macros"],
    deps = ["@nt_crates//:rstest"],
)

nt_rust_library(
    name = "nautilus_portfolio",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "nautilus_portfolio",
    edition = "2024",
    proc_macro_deps = ["@nt_crates//:rust_decimal_macros"],
    deps = [
        "//crates/analysis:nautilus_analysis",
        "//crates/common:nautilus_common",
        "//crates/core:nautilus_core",
        "//crates/model:nautilus_model",
        "@nt_crates//:ahash",
        "@nt_crates//:bon",
        "@nt_crates//:log",
        "@nt_crates//:rust_decimal",
        "@nt_crates//:serde",
        "@nt_crates//:serde_json",
    ],
)
