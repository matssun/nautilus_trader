# nautilus-risk — risk management glue.

load("@nt_bazel_defs//rust:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

nt_rust_test(
    name = "nautilus_risk_test",
    crate = ":nautilus_risk",
    edition = "2024",
    proc_macro_deps = ["@nt_crates//:rust_decimal_macros"],
    deps = ["@nt_crates//:rstest"],
)

nt_rust_library(
    name = "nautilus_risk",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "nautilus_risk",
    edition = "2024",
    proc_macro_deps = ["@nt_crates//:rust_decimal_macros"],
    deps = [
        "//crates/common:nautilus_common",
        "//crates/core:nautilus_core",
        "//crates/execution:nautilus_execution",
        "//crates/model:nautilus_model",
        "//crates/portfolio:nautilus_portfolio",
        "@nt_crates//:ahash",
        "@nt_crates//:bon",
        "@nt_crates//:indexmap",
        "@nt_crates//:log",
        "@nt_crates//:rust_decimal",
        "@nt_crates//:ustr",
    ],
)
