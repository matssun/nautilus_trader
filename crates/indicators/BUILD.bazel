# nautilus-indicators — technical indicators library (moving averages,
# RSI, MACD, order-book imbalance, etc.). Pure compute; depends only
# on core + model.

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "nautilus_indicators",
    srcs = glob(["src/**/*.rs"]),
    crate_features = [],
    crate_name = "nautilus_indicators",
    edition = "2024",
    deps = [
        "//crates/core:nautilus_core",
        "//crates/model:nautilus_model",
        "@nt_crates//:anyhow",
        "@nt_crates//:arraydeque",
        "@nt_crates//:strum",
    ],
)
