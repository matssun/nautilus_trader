# nautilus-model — domain model (instruments, orders, prices, quantities,
# order books, greeks, plus the DeFi on-chain domain types in src/defi/).

load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@nt_bazel_defs//rust:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    build_script_env = {
        "CARGO_PKG_VERSION": "0.56.0",
    },
    crate_features = [
        "defi",
        "high-precision",
        "stubs",
    ],
    data = [
        "cbindgen.toml",
        "cbindgen_cython.toml",
    ],
    edition = "2024",
    deps = [],
)

nt_rust_test(
    name = "nautilus_model_test",
    crate = ":nautilus_model",
    crate_features = [
        "defi",
        "high-precision",
        "stubs",
    ],
    edition = "2024",
    deps = [
        "@nt_crates//:proptest",
    ],
)

nt_rust_library(
    name = "nautilus_model",
    srcs = glob(["src/**/*.rs"]),
    # rstest's #[fixture] proc-macro calls proc-macro-crate at expansion
    # time, which reads Cargo.toml via CARGO_MANIFEST_DIR.
    compile_data = ["Cargo.toml"],
    crate_features = [
        "defi",
        "high-precision",
        "stubs",
    ],
    crate_name = "nautilus_model",
    edition = "2024",
    proc_macro_deps = [
        "@nt_crates//:enum_dispatch",
        "@nt_crates//:rust_decimal_macros",
    ],
    deps = [
        ":build_script",
        "//crates/core:nautilus_core",
        "@nt_crates//:ahash",
        "@nt_crates//:alloy-primitives",
        "@nt_crates//:anyhow",
        "@nt_crates//:arrow",
        "@nt_crates//:chrono",
        "@nt_crates//:dashmap",
        "@nt_crates//:derive_builder",
        "@nt_crates//:implied-vol",
        "@nt_crates//:indexmap",
        "@nt_crates//:log",
        "@nt_crates//:rstest",
        "@nt_crates//:rust_decimal",
        "@nt_crates//:serde",
        "@nt_crates//:serde_json",
        "@nt_crates//:strum",
        "@nt_crates//:tabled",
        "@nt_crates//:thiserror",
        "@nt_crates//:ustr",
    ],
)
