# nautilus-persistence — parquet / datafusion-backed data persistence layer.

load("@nt_bazel_defs//rust:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

nt_rust_test(
    name = "nautilus_persistence_test",
    crate = ":nautilus_persistence",
    edition = "2024",
    deps = [
        "//crates/testkit:nautilus_testkit",
        "@nt_crates//:pretty_assertions",
        "@nt_crates//:proptest",
        "@nt_crates//:rand",
        "@nt_crates//:rstest",
        "@nt_crates//:rust_decimal",
        "@nt_crates//:tempfile",
    ],
)

nt_rust_library(
    name = "nautilus_persistence",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "nautilus_persistence",
    edition = "2024",
    proc_macro_deps = [
        "//crates/persistence/macros:nautilus_persistence_macros",
    ],
    deps = [
        "//crates/common:nautilus_common",
        "//crates/core:nautilus_core",
        "//crates/model:nautilus_model",
        "//crates/serialization:nautilus_serialization",
        "@nt_crates//:ahash",
        "@nt_crates//:anyhow",
        "@nt_crates//:arrow",
        "@nt_crates//:arrow-row",
        "@nt_crates//:chrono",
        "@nt_crates//:chrono-tz",
        "@nt_crates//:datafusion",
        "@nt_crates//:futures",
        "@nt_crates//:indexmap",
        "@nt_crates//:itertools",
        "@nt_crates//:log",
        "@nt_crates//:object_store",
        "@nt_crates//:parquet",
        "@nt_crates//:serde",
        "@nt_crates//:serde_json",
        "@nt_crates//:tokio",
        "@nt_crates//:unbounded-interval-tree",
        "@nt_crates//:url",
        "@nt_crates//:urlencoding",
    ],
)
