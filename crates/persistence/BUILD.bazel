# nautilus-persistence — parquet / datafusion-backed data persistence
# layer. Heavy Arrow + parquet + datafusion + object_store deps.
#
# Cargo defaults are off (no python, no ffi, no cloud). The `high-precision`
# feature is implicitly matched via nautilus-model which we already build
# with high-precision on.

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "nautilus_persistence",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/**/tests.rs"],
    ),
    crate_features = [],
    crate_name = "nautilus_persistence",
    edition = "2024",
    proc_macro_deps = [
        "//crates/persistence/macros:nautilus_persistence_macros",
    ],
    deps = [
        "//crates/common:nautilus_common",
        "//crates/core:nautilus_core",
        "//crates/model:nautilus_model",
        "//crates/serialization:nautilus_serialization",
        "@nt_crates//:ahash",
        "@nt_crates//:anyhow",
        "@nt_crates//:arrow",
        "@nt_crates//:arrow-row",
        "@nt_crates//:chrono",
        "@nt_crates//:chrono-tz",
        "@nt_crates//:datafusion",
        "@nt_crates//:futures",
        "@nt_crates//:indexmap",
        "@nt_crates//:itertools",
        "@nt_crates//:log",
        "@nt_crates//:object_store",
        "@nt_crates//:parquet",
        "@nt_crates//:serde",
        "@nt_crates//:serde_json",
        "@nt_crates//:tokio",
        "@nt_crates//:unbounded-interval-tree",
        "@nt_crates//:url",
        "@nt_crates//:urlencoding",
    ],
)
