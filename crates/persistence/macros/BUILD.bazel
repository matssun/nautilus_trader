# nautilus-persistence-macros — proc-macro crate exposing `#[custom_data]`.

load("@rules_rust//rust:defs.bzl", "rust_proc_macro")

package(default_visibility = ["//visibility:public"])

rust_proc_macro(
    name = "nautilus_persistence_macros",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "nautilus_persistence_macros",
    edition = "2024",
    deps = [
        "@nt_crates//:proc-macro2",
        "@nt_crates//:quote",
        "@nt_crates//:syn",
    ],
)
