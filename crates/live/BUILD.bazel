# nautilus-live — live trading node runtime.

load("@nt_bazel_defs//rust:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

nt_rust_test(
    name = "nautilus_live_test",
    crate = ":nautilus_live",
    crate_features = ["defi"],
    edition = "2024",
    proc_macro_deps = ["@nt_crates//:rust_decimal_macros"],
    # Timing-sensitive test; see comment in common/BUILD.bazel.
    skip_tests = [
        "live::clock::tests::test_live_timer_short_delay_not_early",
    ],
    deps = ["@nt_crates//:rstest"],
)

nt_rust_library(
    name = "nautilus_live",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["defi"],
    crate_name = "nautilus_live",
    edition = "2024",
    deps = [
        "//crates/common:nautilus_common",
        "//crates/core:nautilus_core",
        "//crates/data:nautilus_data",
        "//crates/execution:nautilus_execution",
        "//crates/model:nautilus_model",
        "//crates/portfolio:nautilus_portfolio",
        "//crates/risk:nautilus_risk",
        "//crates/system:nautilus_system",
        "//crates/trading:nautilus_trading",
        "@nt_crates//:ahash",
        "@nt_crates//:anyhow",
        "@nt_crates//:bon",
        "@nt_crates//:indexmap",
        "@nt_crates//:log",
        "@nt_crates//:rust_decimal",
        "@nt_crates//:serde",
        "@nt_crates//:serde_json",
        "@nt_crates//:tabled",
        "@nt_crates//:tokio",
        "@nt_crates//:ustr",
    ],
)
