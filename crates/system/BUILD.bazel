# nautilus-system — top-level kernel / node orchestration.

load("@nt_bazel_defs//rust:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

nt_rust_test(
    name = "nautilus_system_test",
    crate = ":nautilus_system",
    crate_features = ["live"],
    edition = "2024",
    deps = ["@nt_crates//:rstest"],
)

nt_rust_library(
    name = "nautilus_system",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["live"],
    crate_name = "nautilus_system",
    edition = "2024",
    deps = [
        "//crates/common:nautilus_common",
        "//crates/core:nautilus_core",
        "//crates/data:nautilus_data",
        "//crates/execution:nautilus_execution",
        "//crates/model:nautilus_model",
        "//crates/portfolio:nautilus_portfolio",
        "//crates/risk:nautilus_risk",
        "//crates/trading:nautilus_trading",
        "@nt_crates//:ahash",
        "@nt_crates//:anyhow",
        "@nt_crates//:bon",
        "@nt_crates//:log",
        "@nt_crates//:sysinfo",
        "@nt_crates//:ustr",
    ],
)
