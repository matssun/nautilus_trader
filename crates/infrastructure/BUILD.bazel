# nautilus-infrastructure — cache, msgbus, message store backed by
# Redis or Postgres. `postgres` is enabled here because the
# blockchain adapter requires a Postgres-backed cache for on-chain
# state (blocks, logs, pool state). `redis` (the Cargo default) is
# still off — nothing in our build set needs it yet.
#
# Postgres is pulled in via `sqlx` with the `postgres` + `runtime-tokio`
# drivers. NT's source uses only the runtime-checked `sqlx::query(...)`
# builder and FromRow / PgRow types — NOT the `sqlx::query!` /
# `sqlx::query_as!` compile-time-checked macros — so there is no
# .sqlx offline query cache to wire into Bazel, and no live DB
# connection required at build time.

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "nautilus_infrastructure",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["postgres"],
    crate_name = "nautilus_infrastructure",
    edition = "2024",
    proc_macro_deps = [
        "@nt_crates//:async-trait",
    ],
    deps = [
        "//crates/common:nautilus_common",
        "//crates/core:nautilus_core",
        "//crates/cryptography:nautilus_cryptography",
        "//crates/model:nautilus_model",
        "@nt_crates//:ahash",
        "@nt_crates//:anyhow",
        "@nt_crates//:async-stream",
        "@nt_crates//:bytes",
        "@nt_crates//:chrono",
        "@nt_crates//:derive_builder",
        "@nt_crates//:futures",
        "@nt_crates//:indexmap",
        "@nt_crates//:log",
        "@nt_crates//:regex",
        "@nt_crates//:rmp-serde",
        "@nt_crates//:rust_decimal",
        "@nt_crates//:serde",
        "@nt_crates//:serde_json",
        "@nt_crates//:sqlx",
        "@nt_crates//:tokio",
        "@nt_crates//:ustr",
    ],
)
