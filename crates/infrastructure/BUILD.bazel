# nautilus-infrastructure — cache, msgbus, message store backed by
# Redis or Postgres. `postgres` is enabled here because the blockchain
# adapter requires a Postgres-backed cache for on-chain state.

load("@nt_bazel_defs//rust:defs.bzl", "nt_rust_library", "nt_rust_test")

package(default_visibility = ["//visibility:public"])

nt_rust_test(
    name = "nautilus_infrastructure_test",
    crate = ":nautilus_infrastructure",
    crate_features = ["postgres"],
    edition = "2024",
    deps = [
        "//crates/persistence:nautilus_persistence",
        "//crates/serialization:nautilus_serialization",
        "@nt_crates//:rstest",
        "@nt_crates//:serde",
    ],
)

nt_rust_library(
    name = "nautilus_infrastructure",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["postgres"],
    crate_name = "nautilus_infrastructure",
    edition = "2024",
    proc_macro_deps = [
        "@nt_crates//:async-trait",
    ],
    deps = [
        "//crates/common:nautilus_common",
        "//crates/core:nautilus_core",
        "//crates/cryptography:nautilus_cryptography",
        "//crates/model:nautilus_model",
        "@nt_crates//:ahash",
        "@nt_crates//:anyhow",
        "@nt_crates//:async-stream",
        "@nt_crates//:bytes",
        "@nt_crates//:chrono",
        "@nt_crates//:derive_builder",
        "@nt_crates//:futures",
        "@nt_crates//:indexmap",
        "@nt_crates//:log",
        "@nt_crates//:regex",
        "@nt_crates//:rmp-serde",
        "@nt_crates//:rust_decimal",
        "@nt_crates//:serde",
        "@nt_crates//:serde_json",
        "@nt_crates//:sqlx",
        "@nt_crates//:tokio",
        "@nt_crates//:ustr",
    ],
)
